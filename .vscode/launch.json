{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++ GDB Debug (Makefile)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/output/a.out",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${workspaceFolder}/output;${workspaceFolder}/vcpkg_installed/x64-mingw-dynamic/bin;C:/mingw64/bin;${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build with Make"
    }
  ]
}